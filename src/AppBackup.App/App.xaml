<Application x:Class="AppBackup.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2060C8" />
    <SolidColorBrush x:Key="AccentDark" Color="#1A4FA6" />
    <SolidColorBrush x:Key="Muted" Color="#5F6B7A" />
    <SolidColorBrush x:Key="Panel" Color="#F4F6FA" />
    <SolidColorBrush x:Key="Line" Color="#D9DEE6" />

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="80" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Padding" Value="18,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDark}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="RowHeight" Value="26" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="White" />
    </Style>
  </Application.Resources>
</Application>
