[
  { "match": "Mozilla Firefox", "wingetId": "Mozilla.Firefox", "paths": [ "%APPDATA%\\Mozilla\\Firefox" ] },
  { "match": "Mozilla Thunderbird", "wingetId": "Mozilla.Thunderbird", "paths": [ "%APPDATA%\\Thunderbird" ] },
  { "match": "^Google Chrome$", "wingetId": "Google.Chrome", "paths": [ "%LOCALAPPDATA%\\Google\\Chrome\\User Data" ],
    "note": "Saved passwords are locked to this Windows account. Turn on Chrome sync to bring them across." },
  { "match": "^Microsoft Edge$", "paths": [ "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data" ],
    "note": "Saved passwords are locked to this Windows account. Edge sync with your Microsoft account is the reliable way to move them." },
  { "match": "^Brave", "wingetId": "Brave.Brave", "paths": [ "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data" ],
    "note": "Saved passwords are locked to this Windows account. Use Brave Sync to bring them across." },
  { "match": "Visual Studio Code", "wingetId": "Microsoft.VisualStudioCode", "paths": [ "%APPDATA%\\Code\\User", "%USERPROFILE%\\.vscode" ] },
  { "match": "^Notepad\\+\\+", "wingetId": "Notepad++.Notepad++", "paths": [ "%APPDATA%\\Notepad++" ] },
  { "match": "^7-Zip", "wingetId": "7zip.7zip", "registry": [ "HKCU\\Software\\7-Zip" ] },
  { "match": "^PuTTY", "wingetId": "PuTTY.PuTTY", "registry": [ "HKCU\\Software\\SimonTatham" ] },
  { "match": "^WinSCP", "wingetId": "WinSCP.WinSCP", "paths": [ "%APPDATA%\\WinSCP.ini" ], "registry": [ "HKCU\\Software\\Martin Prikryl" ] },
  { "match": "^FileZilla", "wingetId": "TimKosse.FileZilla.Client", "paths": [ "%APPDATA%\\FileZilla" ] },
  { "match": "^VLC media player", "wingetId": "VideoLAN.VLC", "paths": [ "%APPDATA%\\vlc" ] },
  { "match": "^OBS Studio", "wingetId": "OBSProject.OBSStudio", "paths": [ "%APPDATA%\\obs-studio" ] },
  { "match": "^Git( version|$)", "wingetId": "Git.Git", "paths": [ "%USERPROFILE%\\.gitconfig" ] },
  { "match": "^Steam$", "wingetId": "Valve.Steam", "paths": [ "%PROGRAMFILES(X86)%\\Steam\\userdata", "%PROGRAMFILES(X86)%\\Steam\\config" ],
    "note": "Games themselves aren't backed up; Steam re-downloads them." },
  { "match": "^KeePass", "wingetId": "DominikReichl.KeePass", "paths": [ "%APPDATA%\\KeePass" ],
    "note": "Only KeePass settings are included. Make sure your .kdbx database file is backed up too." },
  { "match": "^Everything", "wingetId": "voidtools.Everything", "paths": [ "%APPDATA%\\Everything" ] },
  { "match": "^ShareX", "wingetId": "ShareX.ShareX", "paths": [ "%DOCUMENTS%\\ShareX" ] },
  { "match": "^Audacity", "wingetId": "Audacity.Audacity", "paths": [ "%APPDATA%\\audacity" ] },
  { "match": "^GIMP", "wingetId": "GIMP.GIMP", "paths": [ "%APPDATA%\\GIMP" ] },
  { "match": "^Blender", "wingetId": "BlenderFoundation.Blender", "paths": [ "%APPDATA%\\Blender Foundation" ] },
  { "match": "^Sublime Text", "wingetId": "SublimeHQ.SublimeText.4", "paths": [ "%APPDATA%\\Sublime Text" ] },
  { "match": "^Windows Terminal", "wingetId": "Microsoft.WindowsTerminal", "paths": [ "%LOCALAPPDATA%\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState" ] },
  { "match": "PowerToys", "wingetId": "Microsoft.PowerToys", "paths": [ "%LOCALAPPDATA%\\Microsoft\\PowerToys" ] },
  { "match": "^Greenshot", "wingetId": "Greenshot.Greenshot", "paths": [ "%APPDATA%\\Greenshot" ] },
  { "match": "^qBittorrent", "wingetId": "qBittorrent.qBittorrent", "paths": [ "%APPDATA%\\qBittorrent", "%LOCALAPPDATA%\\qBittorrent" ] },
  { "match": "^HandBrake", "wingetId": "HandBrake.HandBrake", "paths": [ "%APPDATA%\\HandBrake" ] },
  { "match": "^MPC-HC", "wingetId": "clsid2.mpc-hc", "registry": [ "HKCU\\Software\\MPC-HC" ] },
  { "match": "^IrfanView", "wingetId": "IrfanSkiljan.IrfanView", "paths": [ "%APPDATA%\\IrfanView" ] },
  { "match": "^calibre", "wingetId": "calibre.calibre", "paths": [ "%APPDATA%\\calibre" ],
    "note": "Only calibre settings are included; your library folder is separate." },
  { "match": "^paint\\.net", "wingetId": "dotPDN.PaintDotNet", "registry": [ "HKCU\\Software\\paint.net" ] },
  { "match": "Minecraft Launcher", "wingetId": "Mojang.MinecraftLauncher",
    "paths": [ "%APPDATA%\\.minecraft\\saves", "%APPDATA%\\.minecraft\\screenshots", "%APPDATA%\\.minecraft\\resourcepacks", "%APPDATA%\\.minecraft\\options.txt" ],
    "note": "Includes Java Edition worlds, screenshots and resource packs." },
  { "match": "^Discord$", "wingetId": "Discord.Discord", "paths": [],
    "note": "Discord keeps everything in your account; nothing local needs backing up." },
  { "match": "^Spotify", "wingetId": "Spotify.Spotify", "paths": [],
    "note": "Spotify keeps playlists in your account; nothing local needs backing up." }
]
